      "old_string": "/* Adding elegant fade animations for recipe transitions */\n.recipe-content {\n  transition: opacity 0.3s ease-in-out, transform 0.3s ease-in-out;\n  opacity: 1;\n  transform: translateY(0);\n}\n\n.recipe-content.fade-out {\n  opacity: 0;\n  transform: translateY(-10px);\n}\n\n.recipe-content.fade-in {\n  opacity: 1;\n  transform: translateY(0);\n}",
      "new_string": "/* Adding elegant fade animations for recipe transitions */\n.recipe-content {\n  transition: opacity 0.3s ease-in-out, transform 0.3s ease-in-out;\n  opacity: 1;\n  transform: translateY(0);\n}\n\n.recipe-content.fade-out {\n  opacity: 0;\n  transform: translateY(-10px);\n}\n\n.recipe-content.fade-in {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n/* Recipe stat badges for quick-scan information */\n.recipe-stat-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.5rem 1rem;\n  border-radius: 1.5rem;\n  background: oklch(0.98 0 0);\n  border: 1px solid oklch(0.92 0 0);\n  font-size: 0.875rem;\n  font-weight: 500;\n  color: var(--color-foreground);\n  transition: all 0.2s ease;\n}\n\n.recipe-stat-badge .stat-icon {\n  font-size: 1rem;\n  line-height: 1;\n}\n\n.recipe-stat-badge:hover {\n  background: oklch(0.96 0 0);\n  transform: translateY(-1px);\n  box-shadow: 0 2px 8px oklch(0 0 0 / 0.1);\n}\n\n.stat-badge-success {\n  background: oklch(0.95 0.05 145);\n  border-color: oklch(0.6 0.15 145);\n  color: oklch(0.3 0.1 145);\n}\n\n.stat-badge-info {\n  background: oklch(0.95 0.05 240);\n  border-color: oklch(0.6 0.15 240);\n  color: oklch(0.3 0.1 240);\n}\n\n/* Ingredient section headers */\n.ingredient-section-header {\n  font-size: 1.125rem;\n  font-weight: 600;\n  font-family: var(--font-serif);\n  color: var(--color-foreground);\n  padding: 0.75rem 1rem;\n  background: oklch(0.98 0 0);\n  border-left: 3px solid var(--color-primary);\n  border-radius: 0.375rem;\n  margin-top: 0.5rem;\n}\n\n/* Empty instructions message styling */\n.empty-instructions-message {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  text-align: center;\n  padding: 3rem 2rem;\n  border-radius: 1rem;\n  background: linear-gradient(135deg, oklch(0.98 0 0) 0%, oklch(0.96 0 0) 100%);\n  border: 2px dashed oklch(0.88 0 0);\n}\n\n.empty-message-icon {\n  font-size: 3rem;\n  line-height: 1;\n  margin-bottom: 1rem;\n  opacity: 0.8;\n}\n\n.empty-message-title {\n  font-size: 1.5rem;\n  font-weight: 600;\n  font-family: var(--font-serif);\n  color: var(--color-foreground);\n  margin-bottom: 0.75rem;\n}\n\n.empty-message-text {\n  font-size: 1rem;\n  color: var(--color-muted-foreground);\n  line-height: 1.6;\n  max-width: 28rem;\n}"
